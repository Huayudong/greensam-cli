<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback 日志配置

  设计目标（交互式 CLI agent）：
    - 控制台：只显示 WARN 及以上，保持 REPL 对话区干净，不再有 INFO 刷红字。
    - 文件：   记录 INFO 及以上并按天/大小滚动。
-->
<configuration>

    <!-- 控制台：仅 WARN/ERROR，避免 INFO 审计日志在终端刷屏；
         %nopex 抑制堆栈输出——完整堆栈只落文件，REPL 对话区不被 Java 堆栈污染
         （工具失败等可恢复错误已由渲染层以 ❌ 行友好呈现） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%nopex%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件：INFO 及以上，按天 + 10MB 滚动，保留 30 天、总量上限 1GB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/greensam.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档命名：greensam.日期.序号.log -->
            <fileNamePattern>logs/greensam.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 根级别 INFO：文件拿全量审计，控制台由 ThresholdFilter 收敛到 WARN -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
