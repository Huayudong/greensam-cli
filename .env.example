# ============================================================
# greensam-cli 配置示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
# 优先级：系统环境变量 > .env 文件 > 内置默认值
# ============================================================

# 【必填】API 密钥
OPENAI_API_KEY=sk-your-key-here

# 【可选】API 地址，可指向任何兼容 OpenAI 格式的服务（中转、网关、本地部署等）
#OPENAI_BASE_URL=https://api.openai.com/v1

# 【可选】模型名称，默认 gpt-4o
#GREENSAM_MODEL=gpt-4o

# 【可选】系统提示词，默认内置中文提示词
#GREENSAM_SYSTEM_PROMPT=你是一个运行在终端里的智能助手。

# 【可选】是否启用流式输出（true / false），默认 true
#GREENSAM_STREAMING=true

# 【可选】HTTP 读超时秒数，默认 300。
# 非流式模式下慢模型的完整生成需要较长时间，过短会 SocketTimeoutException
#GREENSAM_TIMEOUT_SECONDS=300
